# Public deployment: ports 80/443 must reach this server. IP detection is automatic.
WB_TLS_MODE=auto
WB_ACME_EMAIL=
# Optional: override detection; domains must already resolve to this server.
WB_PUBLIC_IP=
WB_TLS_DOMAINS=
# Use 1 for a staging certificate while checking a new installation.
WB_ACME_STAGING=0

WB_HTTP_POOL_MAX=128
WB_HTTP_POOL_PER_ROUTE=8
WB_HTTP_POOL_IDLE=60
WB_HTTP_MAX_CONNECTIONS=128
# Bundled Nginx overwrites X-Real-IP. Trust only that service and loopback.
WB_TRUSTED_PROXIES=nginx,127.0.0.1/32,::1/128
WB_SSE_HEARTBEAT_SECONDS=15
# 0 preserves all SQLite history. JSONL archive retention stays in panel settings.
WB_SQLITE_RETENTION_DAYS=0

# Existing accounts/ and usage/ mounts also contain the new SQLite database.
PUID=0
PGID=0
